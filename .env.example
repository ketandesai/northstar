# ==============================================================================
# Northstar Finance - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local Next.js development,
# or create a .env file for docker-compose overrides.
# ==============================================================================

# ------------------------------------------------------------------------------
# Plaid API Configuration
# Get your API keys at: https://dashboard.plaid.com/team/keys
# ------------------------------------------------------------------------------
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_ENV=sandbox
PLAID_SECRET_SANDBOX=
PLAID_SECRET_PRODUCTION=
PLAID_PRODUCTS=auth,transactions,investments,liabilities
PLAID_COUNTRY_CODES=US

# ------------------------------------------------------------------------------
# PostgreSQL Database
# Used by the app to connect to PostgreSQL. For local development with
# docker-compose, the DATABASE_URL below matches the container defaults.
# ------------------------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/

# ------------------------------------------------------------------------------
# Cron / Scheduled Jobs
# Used to authorize the /api/cron/refresh-balances endpoint. On Vercel, set this
# as a Cron Secret in your project settings so Vercel sends it automatically in
# the Authorization header on cron requests.
# ------------------------------------------------------------------------------
CRON_SECRET=

# ------------------------------------------------------------------------------
# Real Estate Valuation API (RentCast)
# Optional: Get an API key at https://developers.rentcast.io for live AVM data.
# When omitted, realistic simulated estimates are used for local/test workflows.
# ------------------------------------------------------------------------------
RENTCAST_API_KEY=

