# ==============================================================================
# Northstar Finance - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local Next.js development,
# or create a .env file for docker-compose overrides.
# ==============================================================================

# ------------------------------------------------------------------------------
# Plaid API Configuration
# Get your API keys at: https://dashboard.plaid.com/team/keys
# ------------------------------------------------------------------------------
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox
PLAID_PRODUCTS=auth,transactions
PLAID_COUNTRY_CODES=US

# ------------------------------------------------------------------------------
# PostgreSQL Database (Docker)
# Used by docker-compose for the local containerized database
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=northstar
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/northstar
